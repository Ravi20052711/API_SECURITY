# HackTheAPI CyberLabs Base Docker Image for Vulnerable Target Containers
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Django & DRF
RUN pip install --no-cache-dir django djangorestframework djangorestframework-simplejwt django-cors-headers

EXPOSE 8000
